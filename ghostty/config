# Ghostty config - shared by Ghostty and cmux (cmux renders via libghostty)
# Preserved from the user's original Application Support config:
theme = light:SolarizedLight, dark:SolarizedDark
minimum-contrast = 1.3

# cmux recommended ergonomics
font-family = SF Mono
font-size = 13
sidebar-font-size = 14
surface-tab-bar-font-size = 11
scrollback-limit = 50000000
split-divider-color = #586e75
window-padding-x = 3
window-padding-y = 3

# Default directory for new terminals
working-directory = /Users/seishin/Workspace