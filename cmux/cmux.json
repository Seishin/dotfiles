{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "windowTitleTemplate": "[cmux:{windowToken}] {activeWorkspace}",
    "workspaceInheritWorkingDirectory": true
  },
  "terminal": {
    "copyOnSelect": true,
    "showScrollBar": true,
    "autoResumeAgentSessions": true
  },
  "browser": {
    "openTerminalLinksInCmuxBrowser": true,
    "hostsToOpenInEmbeddedBrowser": [
      "localhost",
      "127.0.0.1"
    ]
  },
  "automation": {
    "suppressSubagentNotifications": true
  },
  "workspaceColors": {
    "indicatorStyle": "washRail",
    "colors": {
      "Red": "#C0392B",
      "Blue": "#1565C0",
      "Green": "#27AE60",
      "Purple": "#8E44AD",
      "Orange": "#E67E22"
    }
  },
  "commands": [
    {
      "name": "Hermes VM",
      "keywords": [
        "ssh",
        "hermes",
        "vm",
        "agent"
      ],
      "workspace": {
        "name": "Hermes VM",
        "cwd": "/Users/seishin/Workspace",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "hermes-vm",
                "command": "exec /usr/bin/ssh -t -o ServerAliveInterval=60 seishin@192.168.88.3 'exec /home/seishin/.local/bin/hermes --tui'",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "Dev: slideforge",
      "keywords": [
        "next",
        "slides",
        "ai"
      ],
      "description": "Open slideforge workspace: terminal + claude + dev server + VM ssh",
      "workspace": {
        "name": "slideforge",
        "cwd": "/Users/seishin/Workspace/slideforge",
        "layout": {
          "direction": "horizontal",
          "split": 0.45,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "term",
                    "focus": true
                  }
                ]
              }
            },
            {
              "direction": "vertical",
              "split": 0.5,
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "terminal",
                        "name": "claude",
                        "command": "exec /Users/seishin/.local/bin/claude"
                      }
                    ]
                  }
                },
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "terminal",
                        "name": "dev",
                        "command": "cd /Users/seishin/Workspace/slideforge && exec /usr/local/bin/npm run dev"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
